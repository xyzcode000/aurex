        "severity": {
            "type": "string",
            "allowed_values": [
                "LOW",
                "MEDIUM",
                "HIGH"
            ]
        },
        "reason": {
            "type": "string"
        },
        "evidence": {
            "type": "string"
        }
    },
    "explainability": {
        "global": {
            "description": "Model-level feature importance"
        },
        "project_level": {
            "description": "Evidence-based contributing factors for each project"
        }
    },
    "prediction_horizon": {
        "cost": "Future project outcome",
        "time": "Future project completion / delay",
        "risk": "Future project risk"
